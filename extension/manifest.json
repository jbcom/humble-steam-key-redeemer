{
  "manifest_version": 3,
  "name": "Humble Steam Key Redeemer",
  "version": "1.0.0",
  "description": "Drives Humble Bundle and Steam in the tabs you are already signed into, and reports to the hskr command-line tool.",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.humblebundle.com/*",
    "https://store.steampowered.com/*",
    "https://steamcommunity.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Humble Steam Key Redeemer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
